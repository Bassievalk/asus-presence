    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Bas Valk",
    "email": "basvalk03@gmail.com"
  },
  "api": {
    "getOverview": {
      "method": "GET",
      "path": "/overview"
    },
    "putConfig": {
      "method": "PUT",
      "path": "/config"
    },
    "postPerson": {
      "method": "POST",
      "path": "/person"
    },
    "putPerson": {
      "method": "PUT",
      "path": "/person"
    },
    "deletePerson": {
      "method": "DELETE",
      "path": "/person"
    },
    "postDevice": {
      "method": "POST",
      "path": "/device"
    },
    "putDevice": {
      "method": "PUT",
      "path": "/device"
    },
    "deleteDevice": {
      "method": "DELETE",
      "path": "/device"
    },
    "postRefresh": {
      "method": "POST",
      "path": "/refresh"
    }
  },
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "A monitored person came home"
        },
        "titleFormatted": {
          "en": "[[person]] came home"
        },
        "args": [
          {
            "name": "person",
            "type": "autocomplete",
            "title": {
              "en": "Person"
            }
          }
        ],
        "tokens": [
          {
            "name": "person",
            "type": "string",
            "title": {
              "en": "Person"
            }
          },
          {
            "name": "devices",
            "type": "string",
            "title": {
              "en": "Online devices"
            }
          }
        ],
        "id": "person_came_home"
      },
      {
        "title": {
          "en": "A monitored person left home"
        },
        "titleFormatted": {
          "en": "[[person]] left home"
        },
        "args": [
          {
            "name": "person",
            "type": "autocomplete",
            "title": {
              "en": "Person"
            }
          }
        ],
        "tokens": [
          {
            "name": "person",
            "type": "string",
            "title": {
              "en": "Person"
            }
          }
        ],
        "id": "person_left_home"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "[[person]] is not home"
        },
        "titleFormatted": {
          "en": "[[person]] is not home"
        },
        "args": [
          {
            "name": "person",
            "type": "autocomplete",
            "title": {
              "en": "Person"
            }
          }
        ],
        "id": "person_is_away"
      },
      {
        "title": {
          "en": "[[person]] is home"
        },
        "titleFormatted": {
          "en": "[[person]] is home"
        },
        "args": [
          {
            "name": "person",
            "type": "autocomplete",
            "title": {
              "en": "Person"
            }
          }
        ],
        "id": "person_is_home"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Person",
        "nl": "Persoon"
      },
      "class": "other",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "capabilities": [
        "onoff",
        "presence"
      ],
      "capabilitiesOptions": {
        "onoff": {
          "title": {
            "en": "Home",
            "nl": "Thuis"
          },
          "setable": false,
          "insightsTitleTrue": {
            "en": "Came home",
            "nl": "Thuisgekomen"
          },
          "insightsTitleFalse": {
            "en": "Left home",
            "nl": "Vertrokken"
          }
        }
      },
      "images": {
        "small": "/drivers/person/assets/images/small.png",
        "large": "/drivers/person/assets/images/large.png",
        "xlarge": "/drivers/person/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "person"
    }
  ],
  "widgets": {
    "presence-overview": {
      "name": {
        "en": "ASUS Presence Overview"
      },
      "height": 320,
      "settings": [],
      "api": {
        "getStatus": {
          "method": "GET",
          "path": "/status"
        },
        "postRestore": {
          "method": "POST",
          "path": "/restore"
        }
      },
      "id": "presence-overview"
    }
  },
  "capabilities": {
    "presence": {
      "type": "number",
      "title": {
        "en": "Presence",
        "nl": "Aanwezigheid"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/drivers/person/assets/icon.svg",
      "min": 0,
      "max": 1,
      "step": 1,
      "decimals": 0
    }
  }
}